# Konfigurasi bikinin SSO. Salin ke .env (di folder ini, di luar webroot) lalu isi.
#   cp .env.example .env && chmod 600 .env
# Prioritas: environment server > .env > config/*.php > default.
# Nilai kosong dianggap tidak di-set. Jangan commit .env.
# Format: KEY=VALUE; nilai dengan spasi/# pakai kutip "..." atau '...'.

# --- Aplikasi ---
# URL publik SSO untuk tautan email (bukan dari header Host).
APP_BASE_URL=https://sso.contoh.id
# true/false (false untuk produksi)
APP_DEBUG=false
MAIL_FROM=
# Direktori private key RS256 (di luar webroot, izin 0700). Kosong = <sso>/keys
KEY_DIR=
# Proxy tepercaya, dipisah koma (IP atau CIDR). Kosong = abaikan X-Forwarded-For.
TRUSTED_PROXIES=

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bikinin_sso
DB_USER=
DB_PASS=

# --- Rahasia (buat acak di server, jangan pakai contoh) ---
# Buat tiap nilai: php -r 'echo base64_encode(random_bytes(32)), "\n";'
HMAC_KEY=
# ID kunci enkripsi aktif dan daftar kunci: id:base64 dipisah koma (rotasi: tambah v2, ganti CURRENT)
ENCRYPTION_KEY_CURRENT=v1
ENCRYPTION_KEYS=v1:

# --- Opsional (CLI/instalasi) ---
# Token sekali pakai untuk halaman /install; hapus setelah instalasi.
BSSO_INSTALL_TOKEN=
# Password admin awal untuk bin/create-admin.php
BSSO_ADMIN_PASSWORD=
